{% comment %}
  =============================================================================
  Ecomexperts Hiring Test - Custom Banner Section (Simplified)
  File: sections/ecomexperts-banner.liquid

  Key Architectural Points:
  1. Built from scratch without copying or modifying Dawn core components.
  2. Pure semantic HTML5, scoped CSS, and zero jQuery or external libraries.
  3. Responsive layout matching Figma:
     - Desktop:
       * Top bar with brand logo, center message, yellow "CHOOSE GIFT →" button.
       * Full-background hero with bottom-left content and animated "SHOP NOW →" button.
       * Bottom announcement strip ("SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL").
     - Mobile:
       * Header with left hamburger menu toggle and centered brand logo.
       * Full-background hero with bottom-left content.
       * Bottom announcement strip with mobile text override.
  4. All text, links, colors, and images are customizable in the Theme Editor.
  5. Uses standard Shopify image_picker settings and a clean background-color fallback.
  =============================================================================
{% endcomment %}

{%- liquid
  assign header_title = section.settings.header_title | default: 'TISSO VISON'
  assign header_message = section.settings.header_message | default: 'Find the ideal gift for your loved ones.'
  assign header_btn_label = section.settings.header_button_label | default: 'CHOOSE GIFT'
  assign header_btn_link = section.settings.header_button_link | default: '#'

  assign heading = section.settings.heading | default: 'The Gift Guide'
  assign desc_desktop = section.settings.description_desktop | default: 'Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.'
  assign desc_mobile = section.settings.description_mobile | default: 'Discover Joy: Your Ultimate Holiday Gift Destination.'
  assign button_label = section.settings.button_label | default: 'SHOP NOW'
  assign button_link = section.settings.button_link | default: '#'

  assign ann_text_desktop = section.settings.announcement_text_desktop | default: 'SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL'
  assign ann_text_mobile = section.settings.announcement_text_mobile | default: 'SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR'

-%}

<div id="ecom-banner-{{ section.id }}" class="ecom-banner" data-section-id="{{ section.id }}">
  <style>
    /* ==========================================================================
       Scoped Styles for Ecomexperts Banner Section
       ========================================================================== */
    #ecom-banner-{{ section.id }} {
      --eb-bg-color: {{ section.settings.bg_color | default: '#ffffff' }};
      --eb-text-color: {{ section.settings.text_color | default: '#000000' }};
      --eb-header-bg: {{ section.settings.header_bg | default: '#ffffff' }};
      --eb-header-border: {{ section.settings.header_border | default: '#f0f0f0' }};
      --eb-yellow-btn-bg: {{ section.settings.header_button_bg | default: '#FFF544' }};
      --eb-yellow-btn-text: {{ section.settings.header_button_text_color | default: '#000000' }};
      --eb-shop-btn-bg: {{ section.settings.button_bg | default: '#000000' }};
      --eb-shop-btn-text: {{ section.settings.button_text_color | default: '#ffffff' }};
      --eb-ann-bg: {{ section.settings.announcement_bg | default: '#f4f4f4' }};
      --eb-ann-text: {{ section.settings.announcement_text_color | default: '#000000' }};
      
      background-color: var(--eb-bg-color);
      color: var(--eb-text-color);
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    #ecom-banner-{{ section.id }} * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* --------------------------------------------------------------------------
       1. Top Header Bar
       -------------------------------------------------------------------------- */
    #ecom-banner-{{ section.id }} .ecom-banner__header {
      background-color: var(--eb-header-bg);
      border-bottom: 1px solid var(--eb-header-border);
    }

    #ecom-banner-{{ section.id }} .ecom-banner__header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1401px;
      margin: 0 auto;
      padding: 0 32px;
      height: 64px;
      position: relative;
      z-index: 10;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__logo {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--eb-text-color);
      text-decoration: none;
      display: inline-block;
      white-space: nowrap;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__logo-image {
      display: block;
      width: auto;
      max-width: 151px;
      object-fit: contain;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__header-message {
      font-size: 16px;
      color: var(--eb-text-color);
      text-align: center;
      flex: 1;
      padding: 0 20px;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__header-action {
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__choose-gift-btn {
      display: inline-flex;
      align-items: center;
      gap: 18px;
      background-color: var(--eb-yellow-btn-bg);
      color: var(--eb-yellow-btn-text);
      font-size: 16px;
      font-weight: 400;
      letter-spacing: normal;
      text-transform: uppercase;
      text-decoration: none;
      padding: 11.5px 22px 11.5px 40px;
      border: none;
      cursor: pointer;
      transition: all 0.5s ease;
      white-space: nowrap;
      position: relative;
      line-height: 1.313;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__choose-gift-btn span {
      position: relative;
      z-index: 1;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__choose-gift-btn:hover {
      color: #fff;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__choose-gift-btn:before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
      background-color: #000;
      z-index: 0;
      width: 0;
      transition: all 0.5s ease;
      height: 100%;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__choose-gift-btn:hover:before {
      width: 100%; 
    }

    #ecom-banner-{{ section.id }} .ecom-banner__choose-gift-btn .btn-arrow-icon {
      width: 26px;
      height: auto;
      transition: all 0.5s ease;
      position: relative;
      z-index: 1;
    }

    #ecom-banner-template--27828156367071__ecomexperts_banner .ecom-banner__choose-gift-btn:hover .btn-arrow-icon path {
      fill: #fff;
    }

    /* Mobile Hamburger Trigger */
    #ecom-banner-{{ section.id }} .ecom-banner__hamburger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      width: 20px;
      height: 12px;
      z-index: 15;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__hamburger .menu-icon {
      display: block;
      width: 20px;
      height: 12px;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__hamburger .close-icon {
      display: none;
      width: 15px;
      height: 15px;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__hamburger[aria-expanded="true"] .menu-icon {
      display: none;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__hamburger[aria-expanded="true"] .close-icon {
      display: block;
    }

    /* Mobile Drawer / Dropdown */
    #ecom-banner-{{ section.id }} .ecom-banner__mobile-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: #ffffff;
      border-bottom: 1px solid #e5e5e5;
      padding: 25px 20px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      flex-direction: column;
      gap: 16px;
      text-align: center;
      z-index: 9;
      opacity: 0;
      transform: translateY(-10px);
      transition: opacity 0.3s ease, transform 0.3s ease;
      pointer-events: none;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__mobile-menu.is-active {
      display: flex;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__mobile-menu-text {
      font-size: 16px;
      color: #000;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__mobile-menu-close {
      position: absolute;
      top: 16px;
      right: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 15px;
      height: 15px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__mobile-menu-close img {
      display: block;
      width: 15px;
      height: 15px;
    }

    /* --------------------------------------------------------------------------
       2. Hero Main Area
       -------------------------------------------------------------------------- */
    #ecom-banner-{{ section.id }} .ecom-banner__hero {
      position: relative;
      width: 100%;
      min-height: 780px;
      display: flex;
      align-items: flex-end;
      background-color: var(--eb-bg-color);
      background-repeat: no-repeat;
      background-position: center center;
      background-size: cover;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__content {
      width: 100%;
      max-width: 1401px;
      margin: 0 auto;
      padding: 0 32px 50px;
      z-index: 2;
      text-align: left;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__title {
      font-size: 70px;
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: normal;
      color: var(--eb-text-color);
      margin-bottom: 50px;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__desc {
      font-size: 20px;
      line-height: 1.4;
      color: #000000;
      margin-bottom: 50px;
      max-width: 483px;
      letter-spacing: normal;
    }

    #ecom-banner-{{ section.id }} .desc-text-mobile {
      display: none;
    }

    /* Required SHOP NOW Button Animation */
    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      background-color: var(--eb-shop-btn-bg);
      color: var(--eb-shop-btn-text);
      font-size: 16px;
      font-weight: 400;
      letter-spacing: normal;
      text-transform: uppercase;
      text-decoration: none;
      padding: 11.5px 22px 11.5px 40px;
      border: none;
      cursor: pointer;
      overflow: hidden;
      transition: all 0.5s ease;
      z-index: 1;
      position: relative;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn span {
      position: relative;
      z-index: 1;
    }

    /* Hover State & Arrow Animation */
    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn:hover {
      color: #000;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn:before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
      background-color: #FFF544;
      z-index: 0;
      width: 0;
      transition: all 0.5s ease;
      height: 100%;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn:hover:before {
      width: 100%; 
    }

    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn .btn-arrow-icon {
      width: 26px;
      height: auto;
      transition: all 0.5s ease;
      position: relative;
      z-index: 1;
    }

    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn .btn-arrow-icon path {
      fill: #fff;
    } 

    #ecom-banner-{{ section.id }} .ecom-banner__shop-btn:hover .btn-arrow-icon path {
      fill: #000;
    }

    /* --------------------------------------------------------------------------
       3. Bottom Announcement Strip
       -------------------------------------------------------------------------- */
    #ecom-banner-{{ section.id }} .ecom-banner__announcement {
      background-color: var(--eb-ann-bg);
      color: var(--eb-ann-text);
      text-align: center;
      padding: 9px 32px;
      width: 100%;
      font-size: 16px;
      font-weight: 400;
      letter-spacing: normal;
      text-transform: uppercase;
      text-decoration: none;
      display: block;
      line-height: 1;
    }


    #ecom-banner-{{ section.id }} .ann-text-mobile {
      display: none;
    }

    /* --------------------------------------------------------------------------
       Responsive Mobile Breakpoint (< 768px)
       -------------------------------------------------------------------------- */
    @media screen and (max-width: 767px) {
      #ecom-banner-{{ section.id }} .ecom-banner__header-inner {
        justify-content: center;
        padding: 0 16px;
        height: 65px;
      }

      /* Mobile Hamburger on Left */
      #ecom-banner-{{ section.id }} .ecom-banner__hamburger {
        display: flex;
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
      }

      /* Centered Logo on Mobile */
      #ecom-banner-{{ section.id }} .ecom-banner__logo {
        font-size: 18px;
        letter-spacing: 0.14em;
        text-align: center;
      }

      /* Hide Desktop-only Header Items */
      #ecom-banner-{{ section.id }} .ecom-banner__header-message,
      #ecom-banner-{{ section.id }} .ecom-banner__header-action {
        display: none;
      }

      /* Mobile hero keeps the background and anchors content at bottom-left. */
      #ecom-banner-{{ section.id }} .ecom-banner__hero {
        min-height: 680px;
        background-position: center center;
        align-items: flex-start;
      }

      #ecom-banner-{{ section.id }} .ecom-banner__content {
        padding: 50px 32px 0;
        text-align: center;
      }

      #ecom-banner-{{ section.id }} .ecom-banner__title {
        font-size: 30px;
        margin-bottom: 24px;
        overflow-wrap: anywhere;
      }

      #ecom-banner-{{ section.id }} .ecom-banner__desc {
        font-size: 16px;
        line-height: 1.3;
        margin: 0 0 24px;
        max-width: 320px;
      }

      #ecom-banner-{{ section.id }} .desc-text-desktop {
        display: none;
      }

      #ecom-banner-{{ section.id }} .desc-text-mobile {
        display: inline;
      }

      #ecom-banner-{{ section.id }} .ecom-banner__shop-btn {
        padding: 8px 30px;
        font-size: 16px;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        width: 100%;
        max-width: 193px;
        margin: 0 auto 40px;
      }

      /* Announcement Strip Mobile Switch */
      #ecom-banner-{{ section.id }} .ecom-banner__announcement {
        padding: 10px 14px;
        font-size: 14px;
      }

      #ecom-banner-{{ section.id }} .ann-text-desktop {
        display: none;
      }

      #ecom-banner-{{ section.id }} .ann-text-mobile {
        display: inline;
      }

      #ecom-banner-{{ section.id }} .ecom-banner__choose-gift-btn {
        max-width: 244px;
        margin: 0 auto;
      }
    }
  </style>

  {% comment %} ==================== TOP HEADER BAR ==================== {% endcomment %}
