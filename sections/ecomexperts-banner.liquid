          <img src="{{ 'ecom-hamburger.svg' | asset_url }}" width="20" height="12" alt="" aria-hidden="true" class="menu-icon">
          <img src="{{ 'ecom-close.svg' | asset_url }}" width="15" height="15" alt="" aria-hidden="true" class="close-icon">
