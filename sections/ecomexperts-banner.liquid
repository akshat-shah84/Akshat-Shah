{% comment %}
  =============================================================================
  Mobile Navigation Hamburger Interaction (Pure Vanilla JavaScript, Zero jQuery)
  =============================================================================
{% endcomment %}
<script>
  (function() {
    var sectionId = {{ section.id | json }};
    var hamburger = document.getElementById('ecom-hamburger-' + sectionId);
    var menu = document.getElementById('ecom-mobile-menu-' + sectionId);
    var closeButton = menu && menu.querySelector('.ecom-banner__mobile-menu-close');

    if (hamburger && menu) {
      hamburger.addEventListener('click', function() {
        var isExpanded = hamburger.getAttribute('aria-expanded') === 'true';
        var shouldOpen = !isExpanded;
        hamburger.setAttribute('aria-expanded', String(shouldOpen));
        hamburger.setAttribute('aria-label', shouldOpen ? 'Close menu' : 'Open menu');
        menu.classList.toggle('is-active', shouldOpen);
      });

      if (closeButton) {
        closeButton.addEventListener('click', function() {
          hamburger.setAttribute('aria-expanded', 'false');
          hamburger.setAttribute('aria-label', 'Open menu');
          menu.classList.remove('is-active');
          hamburger.focus();
        });
      }

      // Close menu when clicking outside
      document.addEventListener('click', function(event) {
        if (!hamburger.contains(event.target) && !menu.contains(event.target)) {
          hamburger.setAttribute('aria-expanded', 'false');
          hamburger.setAttribute('aria-label', 'Open menu');
          menu.classList.remove('is-active');
        }
      });
    }
  })();
</script>

{% schema %}
{
